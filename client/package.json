{
  "name": "pulverize-client",
  "version": "1.1.0",
  "description": "Pulverize 桌面客户端：本地静态前端 + /api 同源代理 + 后端自动拉起",
  "main": "main.js",
  "author": "Pulverize",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File build_icon.ps1",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pulverize.client",
    "productName": "Pulverize",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "package.json",
      {
        "from": "../frontend/dist",
        "to": "dist"
      }
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulverize",
      "uninstallDisplayName": "Pulverize 运动分析"
    }
  }
}
